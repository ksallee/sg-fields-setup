{
	"name": "sg-fields-setup",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Keep named sets of Flow PT field definitions, compare them with a live site and install them, built on sg-widgets.",
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"lint": "oxlint --deny-warnings",
		"check:build": "node scripts/check-build.mjs"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22.20.5",
		"fake-indexeddb": "^6.2.5",
		"oxlint": "^1.93.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.3",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lucide/svelte": "^1.70.0",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"fflate": "^0.8.3",
		"sg-widgets-core": "^0.4.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	}
}
