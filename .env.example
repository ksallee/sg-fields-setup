# Dev only. With these set, `pnpm dev` reads the site through the script key and no sign-in is needed.
# A production build ignores them: the page then signs in through the App Session Launcher.
FPT_API_SITE_URL=https://studio.shotgrid.autodesk.com
FPT_API_SCRIPT_NAME=
FPT_API_API_KEY=
# Fills the site field on the connect page. It never connects by itself.
PUBLIC_FPT_SITE_URL=https://studio.shotgrid.autodesk.com
# Server only, optional. Site hosts allowed beside *.shotgrid.autodesk.com and *.shotgunstudio.com:
# comma-separated host names, each allowed with its subdomains. Empty allows the two domains alone.
# Read when the app is built (the Content Security Policy) and when it runs (the /live/ endpoints).
FPT_EXTRA_SITE_SUFFIXES=
